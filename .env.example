# ==============================================================================
# CODEX Agent: Environment Variables Configuration Template
# Copy this file to .env and configure your local credentials:
#   cp .env.example .env
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Groq LLM Configuration (Required)
# Get your free high-speed API key at: https://console.groq.com/keys
# ------------------------------------------------------------------------------
GROQ_API_KEY=your_groq_api_key_here
GROQ_MODEL=openai/gpt-oss-120b

# ------------------------------------------------------------------------------
# 2. Local Embeddings & Ollama (Default: all-minilm)
# Make sure Ollama is installed and running:
#   ollama serve
#   ollama pull all-minilm
# ------------------------------------------------------------------------------
EMBEDDING_MODEL=all-minilm
OLLAMA_BASE_URL=http://127.0.0.1:11434

# ------------------------------------------------------------------------------
# 3. Application Server Ports & Networking
# ------------------------------------------------------------------------------
STREAMLIT_PORT=8501
HOST=0.0.0.0
